# 분석 도구. 쓰는 것 하나만 채우면 된다. 비우면 스크립트가 붙지 않는다.
# Plausible: 쿠키를 쓰지 않아 동의 배너 없이 방문자와 이벤트를 볼 수 있다.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_UMAMI_ID=
NEXT_PUBLIC_GA_ID=

# 검색엔진 소유 확인 코드. 메타 태그 방식에서 content 값만 넣는다.
NEXT_PUBLIC_GOOGLE_VERIFICATION=
NEXT_PUBLIC_NAVER_VERIFICATION=

# 도메인을 붙이면 여기만 바꾸면 된다. 사이트맵과 og 주소가 따라간다.
NEXT_PUBLIC_SITE_URL=
